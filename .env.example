# --- API source ---
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_LATITUDE=48.8566
WEATHER_LONGITUDE=2.3522
WEATHER_CITY=Paris

# --- Data Lake (HDFS) ---
HDFS_NAMENODE_HOST=namenode
HDFS_NAMENODE_PORT=9870
HDFS_RAW_PATH=/data-lake/raw/weather

# --- Data Warehouse (PostgreSQL) ---
POSTGRES_HOST=postgres-dwh
POSTGRES_PORT=5432
POSTGRES_DB=dwh
POSTGRES_USER=dwh_user
POSTGRES_PASSWORD=change_me
POSTGRES_TABLE=weather_hourly

# --- Airflow ---
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# --- Ports exposés sur l'hôte (à changer en cas de conflit, ex. serveur partagé) ---
# AIRFLOW_WEBSERVER_PORT=8080
# NAMENODE_UI_PORT=9870
# NAMENODE_RPC_PORT=9820
# DATANODE_UI_PORT=9864
# SPARK_MASTER_RPC_PORT=7077
# SPARK_MASTER_UI_PORT=8081
# DWH_POSTGRES_PORT=5432
# DWH_POSTGRES_BIND=127.0.0.1   # mettre 0.0.0.0 pour exposer la DB publiquement (déconseillé)
